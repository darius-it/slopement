{
  "name": "slopement",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "GOFLAGS=-tags=goolm mygo dev",
    "dev:ios": "GOFLAGS=-tags=goolm mygo dev -platform ios",
    "dev:android": "GOFLAGS=-tags=goolm mygo dev -platform android",
    "build": "GOFLAGS=-tags=goolm mygo build",
    "generate": "GOFLAGS=-tags=goolm mygo generate",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mygo-runtime": "^0.10.0"
  },
  "devDependencies": {
    "mygo-cli": "^0.10.0",
    "typescript": "^7",
    "vite": "^8"
  }
}
